class Solution {
    public int majorityElement(int[] nums) {
        HashMap<Integer, Integer> map = new HashMap<>();
        int maxcount = 0;
        int mostrepeated = nums[0];

        for(int num : nums) {
            int count = map.getOrDefault(num,0)+1;
            map.put(num,count);

            if(count>maxcount) {
                maxcount = count;
                mostrepeated = num;
            }
        }
        return mostrepeated;
    }
}